# Copia este archivo como scripts/.env y pon tus valores reales:
#   cp scripts/.env.example scripts/.env
# El .env real NO se sube al repositorio (está en .gitignore).
# Los valores con espacios van entre comillas.

# --- Datos del sujeto del certificado (DN) ---
CERT_COUNTRY=ES
CERT_STATE=Cantabria
CERT_LOCALITY=Torrelavega
CERT_ORGANIZATION="IES Ejemplo"
CERT_ORG_UNIT=Informatica
CERT_EMAIL=admin@example.com

# --- Dominio e IP elástica (van en el CN y en el subjectAltName) ---
DOMAIN=practica-https.test
ELASTIC_IP=203.0.113.10

# --- Validez del certificado en días ---
CERT_DAYS=365

# --- Rutas ---
CERT_KEY=/etc/ssl/private/apache-selfsigned.key
CERT_CRT=/etc/ssl/certs/apache-selfsigned.crt
APACHE_SITES_DIR=/etc/apache2/sites-available
